# SMTP settings for sending contact-form emails
# Use a Gmail App Password (not your normal Gmail login password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=princembowana013@gmail.com
SMTP_PASS=your_gmail_app_password

# Destination inbox for contact-form messages
CONTACT_RECEIVER_EMAIL=princembowana013@gmail.com

# Optional from-address (defaults to SMTP_USER)
CONTACT_FROM_EMAIL=princembowana013@gmail.com
